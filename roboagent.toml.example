# RoboAgent run configuration.
# Relative paths are resolved against this file's directory.
# API keys, endpoints and models live in .env (LLM_* variables, see .env.example).

# LLM provider: "openai", "anthropic", "gemini" or "local" (OpenAI-compatible server).
# Each provider has a predefined API key variable, endpoint and model.
provider = "anthropic"

workdir = "./workspace"
system_prompt = "./prompts/system.md"
max_iterations = 20

# The agent refuses to start if a repository in the workdir is on one of these branches.
protected_branches = ["main"]

# Tools run_command may execute (each runs as `python -m <tool>`).
allowed_commands = ["pytest", "pip", "ruff"]

# Optional: override the provider's model (preset / LLM_*_MODEL) for this run profile.
# model = "claude-opus-4-6"
