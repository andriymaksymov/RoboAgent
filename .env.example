# LLM API configuration. The provider itself is selected in the TOML run config
# (provider = "openai" | "anthropic" | "gemini" | "local").
#
# Lookup order per setting: <PROVIDER>_<KEY>, then LLM_<KEY>, then the provider preset.
# If no API key is set, the provider SDK falls back to its own variable
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY).

# Generic settings (apply to any provider unless overridden below)
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=
# LLM_MODEL=

# OpenAI (Responses API), preset model: gpt-5.4
OPENAI_API_KEY=your_openai_key_here

# Anthropic Claude (Messages API), preset model: claude-sonnet-4-6
ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_MODEL=claude-opus-4-6

# Google Gemini (google-genai), preset model: gemini-2.5-pro
GEMINI_API_KEY=your_gemini_key_here

# Local / on-prem OpenAI-compatible server (vLLM, Ollama, ...), preset URL below
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_MODEL=your-local-model
# LOCAL_API_KEY=

# Run settings (workdir, system prompt, limits, ...) live in the TOML config file,
# see roboagent.toml.example and `python cli.py --help`.
